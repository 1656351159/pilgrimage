<view class="login-page">
  <view class="login-header">
    <view class="logo">
      <view class="logo-icon">
        <text class="logo-text">教</text>
      </view>
    </view>
    <text class="app-title">教育管理系统</text>
    <text class="app-subtitle">专业的教育培训管理平台</text>
  </view>

  <view class="login-body">
    <!-- 微信一键登录 -->
    <button class="btn-wx-login" bindtap="onWxLogin">
      <text class="btn-icon">微</text>
      <text>微信一键登录</text>
    </button>

    <view class="divider-line">
      <view class="line"></view>
      <text>或</text>
      <view class="line"></view>
    </view>

    <!-- 手机号登录 -->
    <view class="form-section">
      <view class="input-group">
        <text class="input-icon">手机</text>
        <input class="login-input" type="number" maxlength="11"
          placeholder="请输入手机号" value="{{phone}}"
          bindinput="onPhoneInput" />
      </view>
      <view class="input-group">
        <text class="input-icon">密码</text>
        <input class="login-input" type="text" password
          placeholder="请输入密码" value="{{password}}"
          bindinput="onPasswordInput" />
      </view>
      <button class="btn-phone-login {{canSubmit ? '' : 'btn-disabled'}}"
        bindtap="onPhoneLogin" disabled="{{!canSubmit}}">
        登录
      </button>
    </view>
  </view>

  <view class="login-footer">
    <text class="agreement-text">
      登录即表示同意
      <text class="link">《用户协议》</text>
      和
      <text class="link">《隐私政策》</text>
    </text>
  </view>
</view>
