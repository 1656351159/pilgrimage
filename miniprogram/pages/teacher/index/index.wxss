.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 头部 */
.header {
  position: relative;
  padding: 40rpx 30rpx 60rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(135deg, #52c41a, #389e0d);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0 30rpx;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 统计网格 */
.stats-grid {
  display: flex;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  background-color: rgba(255, 255, 255, 0.3);
  margin: 6rpx 0;
}

/* 区块 */
.section {
  padding: 0 24rpx;
  margin-top: -10rpx;
}

/* 快捷功能 */
.quick-links {
  display: flex;
  flex-wrap: wrap;
}

.quick-link-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.link-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.icon-consume {
  background: linear-gradient(135deg, #52c41a, #73d13d);
}

.icon-report {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
}

.icon-student {
  background: linear-gradient(135deg, #faad14, #ffc53d);
}

.icon-course {
  background: linear-gradient(135deg, #722ed1, #9254de);
}

.quick-link-item text {
  font-size: 24rpx;
  color: #666666;
}

/* 今日课程 */
.schedule-list {
  margin: 0 -10rpx;
}

.schedule-item {
  display: flex;
  align-items: center;
  padding: 20rpx 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.schedule-item:last-child {
  border-bottom: none;
}

.schedule-time {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  flex-shrink: 0;
}

.time-text {
  font-size: 24rpx;
  color: #666666;
}

.time-dot {
  font-size: 20rpx;
  color: #cccccc;
  margin: 2rpx 0;
}

.schedule-info {
  flex: 1;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
}

.course-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 6rpx;
}

.student-name {
  font-size: 24rpx;
  color: #999999;
}

.schedule-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-done {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-pending {
  background-color: #e6f7ff;
  color: #1890ff;
}
