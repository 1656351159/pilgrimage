/* 容器与通用 */
.container {
  padding: 30rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.mt-10 { margin-top: 10rpx; }
.ml-20 { margin-left: 20rpx; }

/* 字体样式 */
.text-bold {
  font-weight: 600;
  font-size: 32rpx;
  color: #333;
}

.text-light {
  color: #999;
}

.text-small {
  font-size: 24rpx;
}

.text-primary {
  color: #1890ff;
}

.text-secondary {
  color: #666;
}

/* 头像区域 */
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e6f7ff;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  border: 2rpx solid #1890ff;
}

/* 快捷功能 */
.quick-links {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}

.quick-link-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.link-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.icon-class { background: linear-gradient(135deg, #1890ff, #40a9ff); }
.icon-report { background: linear-gradient(135deg, #52c41a, #73d13d); }
.icon-payment { background: linear-gradient(135deg, #faad14, #ffc53d); }

/* 列表项 */
.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}
