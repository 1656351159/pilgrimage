/* 容器与通用 */
.container {
  padding: 30rpx;
  box-sizing: border-box;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-10 {
  margin-top: 10rpx;
}

/* 字体样式 */
.text-bold {
  font-weight: 600;
  font-size: 36rpx;
  color: #333;
}

.text-light {
  color: #999;
}

.text-small {
  font-size: 24rpx;
}

.text-primary {
  color: #1890ff;
}

/* 头像区域 */
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e6f7ff;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  border: 2rpx solid #1890ff;
}

/* 数据概览网格 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stats-item {
  width: 48%;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  color: #666;
}

/* 菜单列表 */
.menu {
  display: flex;
  flex-direction: column;
}

.list-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: #f5f5f5;
}

.list-item::after {
  content: '>';
  color: #ccc;
  font-size: 32rpx;
}
