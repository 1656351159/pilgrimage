.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

.header {
  position: relative;
  padding: 40rpx 30rpx 60rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.section {
  padding: 0 24rpx;
  margin-top: -10rpx;
}

/* 子女列表 */
.children-list {
  margin: 0 -10rpx;
}

.child-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.child-item.active {
  background-color: #e6f7ff;
  border-color: #1890ff;
}

.child-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.child-avatar text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.child-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.child-desc {
  font-size: 24rpx;
  color: #999999;
}

.check-icon {
  color: #1890ff;
  font-size: 36rpx;
  font-weight: 700;
}

/* 快捷功能 */
.quick-links {
  display: flex;
  flex-wrap: wrap;
}

.quick-link-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.link-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.icon-class {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
}

.icon-report {
  background: linear-gradient(135deg, #52c41a, #73d13d);
}

.icon-payment {
  background: linear-gradient(135deg, #faad14, #ffc53d);
}

.icon-coupon {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
}

.quick-link-item text {
  font-size: 24rpx;
  color: #666666;
}

/* 课时记录 */
.record-list {
  margin: 0 -10rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-course {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 6rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999999;
}

.record-hours {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
}
