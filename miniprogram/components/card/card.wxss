.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.card-title-bar {
  width: 6rpx;
  height: 30rpx;
  background-color: #1890ff;
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.card-extra {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999999;
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #cccccc;
  border-right: 3rpx solid #cccccc;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.card-body {
  padding: 30rpx;
}

.card-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}
